diff --git a/tests/audio-render-test.py b/tests/audio-render-test.py
--- /dev/null
+++ b/tests/audio-render-test.py
@@ -0,0 +1,110 @@
+"""Exercise the actual rendered deployment and rotating Unix socket semantics."""
+import copy
+import importlib.util
+import socket
+import tempfile
+import unittest
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('audio_render', ROOT / 'nixos/audio-render.py')
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+class RenderTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.original = yaml.safe_load((ROOT / 'k8s/120-audio/deployment.yaml').read_text())
+        self.source = self.root / 'deployment.yaml'
+        self.out = self.root / 'rendered.yaml'
+
+    def create(self, value):
+        self.source.write_text(yaml.safe_dump(value))
+
+    def test_real_deployment_adds_runtime_gid_without_changing_other_values(self):
+        original = copy.deepcopy(self.original)
+        security = original['spec']['template']['spec']['securityContext']
+        security['supplementalGroups'] = [321, 888]
+        self.create(original)
+        MODULE.render(self.source, self.out, '777')
+        result = yaml.safe_load(self.out.read_text())
+        result_security = result['spec']['template']['spec']['securityContext']
+        self.assertEqual(result_security['supplementalGroups'], [321, 777, 888])
+        del result_security['supplementalGroups']
+        del security['supplementalGroups']
+        self.assertEqual(result, original)
+        self.assertNotIn('777', self.source.read_text())
+
+    def test_bad_gid_and_unsafe_security_fail_closed_without_output(self):
+        for gid in ('', '0', '-1', '12x', '4294967296'):
+            self.create(self.original)
+            with self.assertRaises(ValueError):
+                MODULE.render(self.source, self.out, gid)
+            self.assertFalse(self.out.exists())
+        altered = copy.deepcopy(self.original)
+        altered['spec']['template']['spec']['securityContext']['fsGroup'] = 5
+        self.create(altered)
+        with self.assertRaises(ValueError):
+            MODULE.render(self.source, self.out, '777')
+        self.assertFalse(self.out.exists())
+
+    def test_secret_preflight_rejects_missing_short_and_equal_values(self):
+        otp, invite = self.root / 'otp', self.root / 'invite'
+        otp.write_bytes(b'a' * 32)
+        with self.assertRaises(OSError):
+            MODULE.validate_secrets(otp, invite)
+        invite.write_bytes(b'b' * 31)
+        with self.assertRaises(ValueError):
+            MODULE.validate_secrets(otp, invite)
+        invite.write_bytes(b'a' * 32)
+        with self.assertRaises(ValueError):
+            MODULE.validate_secrets(otp, invite)
+        invite.write_bytes(b'b' * 32)
+        MODULE.validate_secrets(otp, invite)
+
+    def test_socket_directory_survives_socket_replacement(self):
+        pod = self.original['spec']['template']['spec']
+        volume = next(v for v in pod['volumes'] if v['name'] == 'audio-mail')
+        mount = next(v for v in pod['containers'][0]['volumeMounts'] if v['name'] == 'audio-mail')
+        self.assertEqual(volume['hostPath'], {'path': '/run/audio-mail', 'type': 'Directory'})
+        self.assertEqual(mount['mountPath'], '/run/audio-mail')
+        self.assertTrue(mount['readOnly'])
+        path = self.root / 'submit.sock'
+        first = socket.socket(socket.AF_UNIX)
+        first.bind(str(path))
+        first.close()
+        path.unlink()
+        second = socket.socket(socket.AF_UNIX)
+        self.addCleanup(second.close)
+        second.bind(str(path))
+        second.listen()
+        client = socket.socket(socket.AF_UNIX)
+        self.addCleanup(client.close)
+        client.connect(str(path))
+        conn, _ = second.accept()
+        conn.close()
+
+    def test_policy_selects_only_gateway_in_default_namespace(self):
+        policy = yaml.safe_load((ROOT / 'k8s/120-audio/network-policy.yaml').read_text())
+        spec = policy['spec']
+        self.assertEqual(spec['podSelector']['matchLabels'], {'app': 'audio'})
+        self.assertEqual(spec['policyTypes'], ['Ingress'])
+        rule, = spec['ingress']
+        self.assertEqual(rule['ports'], [{'protocol': 'TCP', 'port': 8000}])
+        peer, = rule['from']
+        self.assertEqual(peer['namespaceSelector']['matchLabels'], {'kubernetes.io/metadata.name': 'default'})
+        selector = peer['podSelector']['matchLabels']
+        gateway = {'app.kubernetes.io/instance': 'ngf', 'app.kubernetes.io/managed-by': 'ngf-nginx',
+                   'app.kubernetes.io/name': 'main-gateway-nginx', 'gateway.networking.k8s.io/gateway-name': 'main-gateway'}
+        self.assertEqual(selector, gateway)
+        self.assertTrue(all(gateway.get(k) == v for k, v in selector.items()))
+        self.assertFalse(all({'app': 'untrusted'}.get(k) == v for k, v in selector.items()))
+
+
+if __name__ == '__main__':
+    unittest.main()
