# Browser, Ubuntu userspace, and bundled fonts must match when updating/comparing PNGs.
# Keep this version aligned with package-lock.json; visual.mjs rejects a mismatch.
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:7852dc5a7d72f5fe458a597d690f6c42fbc8e9e26ddfa95f8e6ef552558d9bbf

WORKDIR /app
COPY .github/scripts/install-ci-native-tools.sh .github/scripts/build-keyfinder.sh .github/scripts/
RUN .github/scripts/install-ci-native-tools.sh
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python UV_NO_DEV=true UV_FROZEN=true
COPY .python-version pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY frontend/package.json frontend/package-lock.json frontend/
RUN npm --prefix frontend ci
COPY backend/ backend/
COPY separator/ separator/
COPY frontend/ frontend/
ENV E2E_VISUAL_RUNTIME=playwright-1.64.1-noble
WORKDIR /app/frontend
ENTRYPOINT ["node", "e2e/run.mjs", "--visual", "--config=playwright.visual.config.ts"]
